# DA3 Q2(c) "before" image — the straightforward first attempt, kept so the
# Trivy scan can be reproduced. Do not deploy it; `Dockerfile` is the hardened
# replacement.
#
# Full Debian base, every dev dependency and the source tree in the final
# image, running as root through `npm start`.
FROM node:22

WORKDIR /app
COPY . .
RUN npm ci

# `next build` imports the Prisma client, which refuses to start without a URL.
# A placeholder is enough to build; the real one is supplied at run time.
ENV DATABASE_URL="postgresql://build:build@localhost:5432/build"
RUN npm run build

EXPOSE 3000
CMD ["npm", "start"]
