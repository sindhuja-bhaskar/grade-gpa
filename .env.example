# ─── Database (§32, §34) ───────────────────────────────────────────────────
# Local development: the local PostgreSQL server (npm run db:create), and also
# the credentials docker-compose.yml uses, so the URL works for either.
DATABASE_URL="postgresql://gradegpa:gradegpa@localhost:5432/gradegpa?schema=public"
# Production: use the cloud provider's POOLED connection string (§34, §41).

# ─── Authentication — Auth.js (§8, §33) ────────────────────────────────────
# Signs the session cookie. Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-in-every-environment"
# How long a session lives without activity; it slides while the student works.
SESSION_TTL_DAYS=30

# ─── App ───────────────────────────────────────────────────────────────────
NODE_ENV=development
