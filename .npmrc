# vitest 5 wants a newer @types/node than this project pins for Node 20, and
# next-auth's beta line declares optional peers it does not need here. Both are
# dev-only resolution noise, but they make a strict `npm ci` fail — which is
# what CI and Vercel run. Setting it here keeps local, CI and deployment installs
# identical instead of relying on a flag someone has to remember.
legacy-peer-deps=true
